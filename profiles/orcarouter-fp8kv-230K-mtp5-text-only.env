SERVED_NAME=qwen38-27b-orcarouter-nvfp4-fp8kv-230K-mtp5-text-only-cu130
COMPATIBLE_MODES=normal
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen3.8-27b-nvfp4
MODEL_VARIANT=nvfp4
QUANTIZATION=compressed-tensors
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=230000
KV_CACHE_MEMORY_BYTES=5115441742
GPU_UTIL=0.90
MAX_BATCHED_TOKENS=2048
MAX_NUM_SEQS=1
MTP_K=5
VLLM_TURBOQUANT_CONTINUATION_PREFIX_COMBINE=auto
VLLM_TURBOQUANT_CONTINUATION_PREFIX_COMBINE_MIN_TOKENS=20480
VLLM_TURBOQUANT_DECODE_BLOCK_KV=2
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1

ENABLE_PREFIX_CACHING=1
ENABLE_PROMPT_TOKENS_DETAILS=1
ENABLE_AUTO_TOOL_CHOICE=1
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml
VLLM_ENFORCE_STRICT_TOOL_CALLING=1
DISABLE_LOG_STATS=0

PYTORCH_CUDA_ALLOC_CONF=garbage_collection_threshold:0.8
